local StatusPara

local function setStatus(txt)
    if StatusPara then pcall(function() StatusPara:SetDesc(txt) end) end
end

local function activatePrompt(pr)
    local oh, od, ol = pr.HoldDuration, pr.MaxActivationDistance, pr.RequiresLineOfSight
    pcall(function()
        pr.HoldDuration = 0
        pr.MaxActivationDistance = 60
        pr.RequiresLineOfSight = false
    end)
    for _ = 1, 4 do
        if not pr.Parent then break end
        pcall(function() fireproximityprompt(pr) end)
        pcall(function()
            pr:InputHoldBegin()
            task.wait(math.max(oh, 0.1))
            pr:InputHoldEnd()
        end)
        task.wait(0.2)
        if not pr.Parent or not pr.Enabled then break end
    end
    pcall(function()
        if pr.Parent then
            pr.HoldDuration, pr.MaxActivationDistance, pr.RequiresLineOfSight = oh, od, ol
        end
    end)
end

local function stealOnce()
    if S.Busy then return end
    S.Busy = true
    S.Cancel = false
    local good, err = pcall(function()
        local home, src = getHome()
        if not home then
            notify("Farm", "Plot não encontrado. Use Config > Redetectar plot.")
            return
        end
        local t = pickTarget()
        if not t then
            setStatus("Nenhum alvo encontrado.")
            notify("Farm", "Nenhum alvo encontrado.")
            return
        end
        Blacklist[t.prompt] = tick() + 10
        setStatus(("Indo: %s (%s, %s) ⚡%s"):format(t.name, t.size, t.tier, fmt(t.income)))
        if not flyTo(t.pos + Vector3.new(0, 3, 0)) then return end
        activatePrompt(t.prompt)
        setStatus("Voltando ao plot (" .. src .. ")")
        flyTo(home + Vector3.new(0, 3, 0))
        setStatus("Pronto. Último: " .. t.name .. " ⚡" .. fmt(t.income))
    end)
    if not good then warn("[Exu] Erro: " .. tostring(err)) end
    S.Busy = false
end

task.spawn(function()
    while not S.Unloaded do
        if S.AutoSteal and not S.Busy then stealOnce() end
        task.wait(S.Delay)
    end
end)


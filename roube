--------------------------------------------------------------------
local function flyTo(pos)
    if not getHRP() then return false end
    S.Moving = true
    local reached = true
    while true do
        local hrp = getHRP()
        if not hrp or S.Cancel or S.Unloaded then reached = false break end
        local delta = pos - hrp.Position
        local dist = delta.Magnitude
        if dist < 1.5 then break end
        local dt = RunService.Heartbeat:Wait()
        hrp = getHRP()
        if not hrp then reached = false break end
        local step = math.min(S.Speed * dt, dist)
        hrp.CFrame = CFrame.new(hrp.Position + delta.Unit * step) * (hrp.CFrame - hrp.CFrame.Position)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    S.Moving = false
    return reached
end


local OrigPrompt = setmetatable({}, { __mode = "k" })

local function restorePrompts()
    for pr, o in pairs(OrigPrompt) do
        if pr.Parent then
            pcall(function()
                pr.HoldDuration = o.hold
                pr.MaxActivationDistance = o.dist
                pr.RequiresLineOfSight = o.los
            end)
        end
    end
    OrigPrompt = setmetatable({}, { __mode = "k" })
end

task.spawn(function()
    while not S.Unloaded do
        if S.InstantPrompt or S.RangeOn then
            for pr in pairs(Prompts) do
                if pr.Parent then
                    if not OrigPrompt[pr] then
                        OrigPrompt[pr] = { hold = pr.HoldDuration, dist = pr.MaxActivationDistance, los = pr.RequiresLineOfSight }
                    end
                    if S.InstantPrompt then pr.HoldDuration = 0 end
                    if S.RangeOn then
                        pr.MaxActivationDistance = S.Range
                        pr.RequiresLineOfSight = false
                    end
                end
            end
        end
        task.wait(1)
    end
end)

task.spawn(function()
    while not S.Unloaded do
        if S.AutoPrompt then
            local hrp = getHRP()
            if hrp then
                for pr in pairs(Prompts) do
                    if pr.Parent and pr.Enabled and not actionMatches(pr) then
                        local txt = (pr.ActionText .. " " .. pr.ObjectText):lower()
                        local hit = false
                        for _, k in ipairs(S.AutoKeys) do
                            if k ~= "" and txt:find(k, 1, true) then hit = true break end
                        end
                        local pos = hit and promptPos(pr)
                        if pos and (pos - hrp.Position).Magnitude <= S.AutoRange then
                            local old = pr.MaxActivationDistance
                            pr.MaxActivationDistance = math.max(old, S.AutoRange)
                            pcall(function() fireproximityprompt(pr) end)
                            pr.MaxActivationDistance = old
                        end
                    end
                end
            end
        end
        task.wait(1)
    end
end)


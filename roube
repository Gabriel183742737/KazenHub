--------------------------------------------------------------------
-- Numeros abreviados (32K, 1.2M, 4Qa ...)
--------------------------------------------------------------------
local Suffix = { K = 1e3, M = 1e6, B = 1e9, T = 1e12, Qa = 1e15, Qi = 1e18, Sx = 1e21, Sp = 1e24, Oc = 1e27, No = 1e30, Dc = 1e33 }
local Units = {
    { 1e33, "Dc" }, { 1e30, "No" }, { 1e27, "Oc" }, { 1e24, "Sp" }, { 1e21, "Sx" }, { 1e18, "Qi" },
    { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" },
}

local function parseAbbrev(txt)
    if type(txt) ~= "string" or #txt > 14 then return nil end
    local clean = (txt:gsub("[^%w%.,]", ""))
    local num, suf = clean:match("^([%d%.,]+)(%a*)$")
    if not num then return nil end
    local n = tonumber((num:gsub(",", "")))
    if not n then return nil end
    local mult = 1
    if suf ~= "" then
        mult = Suffix[suf]
        if not mult then return nil end
    end
    return n * mult
end

local function fmt(n)
    if not n then return "?" end
    for _, u in ipairs(Units) do
        if n >= u[1] then return ("%.3g%s"):format(n / u[1], u[2]) end
    end
    return tostring(math.floor(n))
end


local ESPObjs = {}
local function clearESP()
    for k, h in pairs(ESPObjs) do
        pcall(function() h:Destroy() end)
        ESPObjs[k] = nil
    end
end

task.spawn(function()
    while not S.Unloaded do
        if S.ESP then
            local list = scanTargets()
            sortTargets(list)
            local keep = {}
            for i, t in ipairs(list) do
                local model = t.prompt:FindFirstAncestorOfClass("Model")
                if model then
                    keep[model] = true
                    local h = ESPObjs[model]
                    if not h or not h.Parent then
                        h = Instance.new("Highlight")
                        h.OutlineColor = Color3.new(0, 0, 0)
                        h.Parent = model
                        ESPObjs[model] = h
                    end
                    h.FillColor = Color3.new(1, 1, 1)
                    h.FillTransparency = (i == 1) and 0.1 or 0.65
                end
            end
            for m, h in pairs(ESPObjs) do
                if not keep[m] then
                    pcall(function() h:Destroy() end)
                    ESPObjs[m] = nil
                end
            end
        end
        task.wait(1.5)
    end
end)


local function parseObjectText(ot)
    ot = ot or ""
    local name, size = ot:match("^(.-)%s*%((.-)%)%s*$")
    if not name then name, size = ot, "" end
    return name, size
end

local function tierOf(name)
    local low = name:lower()
    for _, e in ipairs(NameTier) do
        if low:find(e[1], 1, true) then return e[2] end
    end
    return nil
end

local IncomeCache = {}
local function readIncome(prompt)
    local c = IncomeCache[prompt]
    if c and tick() - c.t < 5 then return c.v end
    local anc = prompt.Parent
    local best
    for _ = 1, 4 do
        if not anc or anc == workspace then break end
        for _, d in ipairs(anc:GetDescendants()) do
            if d:IsA("TextLabel") then
                local v = parseAbbrev(d.Text)
                if v and (not best or v > best) then best = v end
            end
        end
        if best then break end
        anc = anc.Parent
    end
    IncomeCache[prompt] = { v = best, t = tick() }
    return best
end

local function hasAny(set)
    for _ in pairs(set) do return true end
    return false
end

local Blacklist = {}

local function actionMatches(pr)
    local a = pr.ActionText:lower()
    for _, k in ipairs(S.ActionKeys) do
        if k ~= "" and a:find(k, 1, true) then return true end
    end
    return false
end

local function scanTargets()
    local list = {}
    local hrp = getHRP()
    local home = getHome()
    local filterTier, filterSize = hasAny(S.Tiers), hasAny(S.Sizes)
    for pr in pairs(Prompts) do
        if pr.Parent and pr.Enabled and actionMatches(pr)
            and not (Blacklist[pr] and Blacklist[pr] > tick())
            and not (LP.Character and pr:IsDescendantOf(LP.Character)) then
            local pos = promptPos(pr)
            if pos and not (home and S.Exclude > 0 and (pos - home).Magnitude < S.Exclude) then
                local name, size = parseObjectText(pr.ObjectText)
                if name == "" then
                    local m = pr:FindFirstAncestorOfClass("Model")
                    name = m and m.Name or "?"
                end
                local tier = tierOf(name) or "?"
                local okTier = (not filterTier) or S.Tiers[tier]
                local okSize = true
                if filterSize then
                    okSize = false
                    local key = size:sub(1, 1):upper()
                    for s in pairs(S.Sizes) do
                        if SizeKey[s] == key then okSize = true break end
                    end
                end
                if okTier and okSize then
                    table.insert(list, {
                        prompt = pr,
                        pos = pos,
                        name = name,
                        size = size,
                        tier = tier,
                        rank = TierRank[tier] or 0,
                        income = readIncome(pr) or 0,
                        dist = hrp and (hrp.Position - pos).Magnitude or 0,
                    })
                end
            end
        end
    end
    return list
end

local function sortTargets(list)
    table.sort(list, function(a, b)
        if S.Mode == MODE_NEAR then return a.dist < b.dist end
        if S.Mode == MODE_RARE then
            if a.rank ~= b.rank then return a.rank > b.rank end
            if a.income ~= b.income then return a.income > b.income end
            return a.dist < b.dist
        end
        if a.income ~= b.income then return a.income > b.income end
        if a.rank ~= b.rank then return a.rank > b.rank end
        return a.dist < b.dist
    end)
end

local function pickTarget()
    local list = scanTargets()
    if #list == 0 then return nil end
    sortTargets(list)
    return list[1]
end


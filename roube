local function ownedByMe(inst)
    for _, k in ipairs({ "Owner", "OwnerId", "OwnerUserId", "UserId", "Player" }) do
        local a = inst:GetAttribute(k)
        if a ~= nil and (a == LP.UserId or a == LP.Name or a == LP.DisplayName or tostring(a) == tostring(LP.UserId)) then
            return true
        end
        local c = inst:FindFirstChild(k)
        if c and c:IsA("ValueBase") then
            local v = c.Value
            if v == LP or v == LP.UserId or v == LP.Name or v == LP.DisplayName then return true end
        end
    end
    return inst.Name == LP.Name or inst.Name == LP.DisplayName
end

local function detectOwnPlot()
    for _, top in ipairs(workspace:GetChildren()) do
        if not Players:GetPlayerFromCharacter(top) then
            local found = ownedByMe(top) and top
            if not found then
                for _, sub in ipairs(top:GetChildren()) do
                    if ownedByMe(sub) then found = sub break end
                end
            end
            if found then
                for _, d in ipairs(found:GetDescendants()) do
                    if d:IsA("BasePart") and d.Name:lower():find("spawn") then return d.Position end
                end
                return found:GetPivot().Position
            end
        end
    end
    return nil
end

local function getHome()
    if S.ManualPlot then return S.ManualPlot, "manual" end
    local rl = LP.RespawnLocation
    if rl and rl:IsA("BasePart") then return rl.Position, "RespawnLocation" end
    if S.Spawned then return S.Spawned, "spawn registrado" end
    if S.OwnPlot then return S.OwnPlot, "plot por dono" end
    if S.Initial then return S.Initial, "posição ao executar" end
    return nil, "nenhum"
end

